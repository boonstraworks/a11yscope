{
  "name": "a11yscope",
  "version": "0.1.0",
  "description": "Fast accessibility scanner (axe-core + Playwright) with European Accessibility Act / EN 301 549 reporting. One command, one clear HTML report.",
  "type": "module",
  "bin": {
    "a11yscope": "bin/cli.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "scan": "node bin/cli.js",
    "demo": "node bin/cli.js examples/broken.html --report a11yscope-report.html"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "axe",
    "axe-core",
    "wcag",
    "eaa",
    "european-accessibility-act",
    "en301549",
    "audit",
    "scanner",
    "cli",
    "playwright"
  ],
  "author": "Steven Boonstra (BoonstraWorks) <info@boonstraworks.nl>",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/boonstraworks/a11yscope.git" },
  "bugs": "https://github.com/boonstraworks/a11yscope/issues",
  "homepage": "https://boonstraworks.nl",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.0",
    "playwright": "^1.48.0"
  }
}
